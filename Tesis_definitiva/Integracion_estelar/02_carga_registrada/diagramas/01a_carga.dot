digraph {
graph [rankdir=TB, labelloc=t, label="Identificación estelar · carga registrada", fontname=Arial, fontsize=22, pad=0.28];
node [shape=circle, style=filled, fillcolor="#EAF1F8", color="#516579", fontname=Arial, fontsize=10];
edge [fontname=Arial, color="#40566C", fontsize=10];
IDLE -> IDLE [label="sin flanco de list_ready"];
IDLE -> FINISH [label="flanco de list_ready y lista vacía o desbordada"];
IDLE -> LOAD_REQ [label="flanco de list_ready y lista disponible"];
LOAD_REQ -> LOAD_WAIT [label="/ rd_index"];
LOAD_WAIT -> LOAD_TAKE;
LOAD_TAKE -> LOAD_NEXT [label="rd_valid = 0"];
LOAD_TAKE -> LOAD_INSERT [label="rd_valid = 1 y lista selecta vacía"];
LOAD_TAKE -> LOAD_RANK [label="rd_valid = 1 y lista selecta con datos"];
LOAD_RANK -> LOAD_COMPARE;
LOAD_COMPARE -> LOAD_INSERT [label="mayor intensidad o último puesto libre"];
LOAD_COMPARE -> LOAD_NEXT [label="lista llena e intensidad insuficiente"];
LOAD_COMPARE -> LOAD_RANK [label="siguiente puesto"];
LOAD_INSERT -> LOAD_NEXT;
LOAD_NEXT -> LOAD_REQ [label="quedan centroides"];
LOAD_NEXT -> FINISH [label="último centroide y muestra insuficiente"];
LOAD_NEXT -> PREP_DIFF [label="último centroide y muestra suficiente"];
FINISH -> IDLE [label="/ done"];
}