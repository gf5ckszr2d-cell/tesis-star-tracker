digraph {
graph [rankdir=TB, labelloc=t, label="Identificación estelar · cálculo de rayos", fontname=Arial, fontsize=22, pad=0.28];
node [shape=circle, style=filled, fillcolor="#EAF1F8", color="#516579", fontname=Arial, fontsize=10];
edge [fontname=Arial, color="#40566C", fontsize=10];
PREP_DIFF -> PREP_SCALE;
PREP_SCALE -> PREP_SQUARE;
PREP_SQUARE -> PREP_RADIUS_SUM;
PREP_RADIUS_SUM -> PREP_RADIUS;
PREP_RADIUS -> FINISH [label="índice de radio > 511"];
PREP_RADIUS -> PREP_NORM [label="índice de radio ≤ 511"];
PREP_NORM -> PREP_PRODUCT;
PREP_PRODUCT -> PREP_ROUND;
PREP_ROUND -> PREP_FINAL;
PREP_FINAL -> PREP_DIFF [label="queda otro centroide"];
PREP_FINAL -> PREP_PAIR_READ [label="último centroide"];
}